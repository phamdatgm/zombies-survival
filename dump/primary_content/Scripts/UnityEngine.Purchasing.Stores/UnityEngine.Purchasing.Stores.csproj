<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>UnityEngine.Purchasing.Stores</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <NoStandardLib>True</NoStandardLib>
    <AppendTargetFrameworkToOutputPath>False</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>False</AppendRuntimeIdentifierToOutputPath>
    <DisableImplicitConfigurationDefines>True</DisableImplicitConfigurationDefines>
    <DisableImplicitFrameworkDefines>True</DisableImplicitFrameworkDefines>
    <DisableImplicitFrameworkReferences>True</DisableImplicitFrameworkReferences>
    <DisableTransitiveProjectReferences>True</DisableTransitiveProjectReferences>
    <DisableImplicitNamespaceImports>True</DisableImplicitNamespaceImports>
    <EnsureRuntimePackageDependencies>False</EnsureRuntimePackageDependencies>
    <AddAdditionalExplicitAssemblyReferences>False</AddAdditionalExplicitAssemblyReferences>
  </PropertyGroup>
  <ItemGroup />
  <ItemGroup>
    <ProjectReference Include="../mscorlib/mscorlib.csproj" />
    <ProjectReference Include="../UnityEngine.Purchasing/UnityEngine.Purchasing.csproj" />
    <ProjectReference Include="../UnityEngine.AndroidJNIModule/UnityEngine.AndroidJNIModule.csproj" />
    <ProjectReference Include="../UnityEngine.CoreModule/UnityEngine.CoreModule.csproj" />
    <ProjectReference Include="../UnityEngine.Purchasing.Security/UnityEngine.Purchasing.Security.csproj" />
    <ProjectReference Include="../UnityEngine.Purchasing.AppleCore/UnityEngine.Purchasing.AppleCore.csproj" />
    <ProjectReference Include="../UnityEngine.Purchasing.SecurityCore/UnityEngine.Purchasing.SecurityCore.csproj" />
    <ProjectReference Include="../Purchasing.Common/Purchasing.Common.csproj" />
    <ProjectReference Include="../UnityEngine.Purchasing.WinRTCore/UnityEngine.Purchasing.WinRTCore.csproj" />
    <ProjectReference Include="../Unity.Services.Core.Internal/Unity.Services.Core.Internal.csproj" />
    <ProjectReference Include="../System/System.csproj" />
    <ProjectReference Include="../System.Core/System.Core.csproj" />
  </ItemGroup>
</Project>